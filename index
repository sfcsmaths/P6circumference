<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>互動數學魔法：葉子的周界</title>
    <!-- 引入 Tailwind CSS (用於排版與美化) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 React 與 ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <!-- 引入 Babel (讓瀏覽器能讀懂 JSX 語法) -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-blue-50">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // 自訂 Icon 元件 (取代原本依賴的外部庫，確保單檔可獨立運行)
        const Lightbulb = ({ size = 24, className = "" }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.2 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
        );
        const CheckCircle2 = ({ size = 24, className = "" }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        );
        const Play = ({ size = 24, className = "" }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><polygon points="5 3 19 12 5 21 5 3"/></svg>
        );
        const Pause = ({ size = 24, className = "" }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><rect width="4" height="16" x="6" y="4"/><rect width="4" height="16" x="14" y="4"/></svg>
        );
        const ChevronLeft = ({ size = 24, className = "" }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="m15 18-6-6 6-6"/></svg>
        );
        const ChevronRight = ({ size = 24, className = "" }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="m9 18 6-6-6-6"/></svg>
        );
        const RotateCcw = ({ size = 24, className = "" }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        );

        // 自訂分數排版元件
        const Fraction = ({ top, bottom }) => (
            <span className="inline-flex flex-col items-center justify-center align-middle mx-1 font-bold">
                <span className="border-b-2 border-current px-1 leading-none pb-[2px]">{top}</span>
                <span className="px-1 leading-none pt-[2px]">{bottom}</span>
            </span>
        );

        function App() {
            const [currentStep, setCurrentStep] = useState(0);
            const [isPlaying, setIsPlaying] = useState(false);
            const [showFullCircleHint, setShowFullCircleHint] = useState(false);
            const [showHalfCircleHint, setShowHalfCircleHint] = useState(false);
            const timerRef = useRef(null);

            useEffect(() => {
                setShowFullCircleHint(false);
                setShowHalfCircleHint(false);
            }, [currentStep]);

            const steps = [
                {
                    title: "🕵️‍♂️ 第一步：觀察神秘的葉子",
                    content: "看看這片夾在正方形裡的綠色葉子，我們要怎麼算出它外圍『一圈的長度』（也就是周界）呢？",
                    detail: "點擊『下一頁』，我們把它拆開來看看！",
                    visual: "full",
                    duration: 5000
                },
                {
                    title: "✂️ 第二步：發現第一個 1/4 圓",
                    content: "原來，左上角藏著一個圓心（黑點）。它畫出了一條橘色的彎彎線...",
                    detail: "這條曲線，剛好是一個完整圓形的四分之一！",
                    visual: "arc1",
                    duration: 5000
                },
                {
                    title: "✂️ 第三步：發現第二個 1/4 圓",
                    content: "右下角也藏著另一個圓心（黑點）！它畫出了另一條一模一樣的彎彎線！",
                    detail: "這片葉子，就是由兩條『1/4 圓周』組合而成的喔！",
                    visual: "arc2",
                    duration: 5000
                },
                {
                    title: "🧮 第四步：算出一條曲線長度",
                    content: "我們來算一條曲線！公式是：直徑 × π × (1/4)。半徑是 28 cm，所以：",
                    detail: (
                        <div className="flex items-center justify-center text-xl mt-2 text-orange-600 bg-orange-50 p-3 rounded-lg">
                            28 × 2 × <Fraction top="22" bottom="7" /> × <Fraction top="1" bottom="4" /> = 44 cm
                        </div>
                    ),
                    visual: "math1",
                    duration: 6000
                },
                {
                    title: "✨ 第五步：組合起來算總和！",
                    content: "因為葉子有『兩條』一模一樣的邊界，所以我們把剛剛算出來的答案乘以 2：",
                    detail: (
                        <div className="flex flex-col items-center justify-center text-2xl mt-2 text-green-700 bg-green-50 p-4 rounded-lg font-bold">
                            <div>44 × 2 = <span className="text-red-500 text-3xl">88 cm</span></div>
                        </div>
                    ),
                    visual: "combine",
                    duration: 5000
                },
                {
                    title: "🎉 恭喜你！解謎成功！",
                    content: "你已經學會怎麼計算這種複雜圖形的周界了！是不是很簡單呢？",
                    detail: "💡 老師的小秘密：兩個 1/4 圓加起來，其實剛好就是『半個圓』的周界喔！你可以用半圓公式再算一次看看！",
                    visual: "celebrate",
                    duration: 6000
                }
            ];

            const totalSteps = steps.length;

            useEffect(() => {
                if (isPlaying) {
                    timerRef.current = setTimeout(() => {
                        if (currentStep < totalSteps - 1) {
                            setCurrentStep(prev => prev + 1);
                        } else {
                            setIsPlaying(false);
                        }
                    }, steps[currentStep].duration);
                }
                return () => clearTimeout(timerRef.current);
            }, [isPlaying, currentStep]);

            const handleNext = () => {
                if (currentStep < totalSteps - 1) setCurrentStep(prev => prev + 1);
                setIsPlaying(false);
            };

            const handlePrev = () => {
                if (currentStep > 0) setCurrentStep(prev => prev - 1);
                setIsPlaying(false);
            };

            const togglePlay = () => {
                if (currentStep === totalSteps - 1) {
                    setCurrentStep(0);
                    setIsPlaying(true);
                } else {
                    setIsPlaying(!isPlaying);
                }
            };

            const renderVisual = () => {
                const v = steps[currentStep].visual;
                const isHintActive = showFullCircleHint && (v === 'arc1' || v === 'arc2');
                const isHalfCircleActive = showHalfCircleHint && v === 'celebrate';

                const getCameraTransform = () => {
                    if (isHintActive) return 'translate(32.3px, 32.3px) scale(0.538)';
                    if (isHalfCircleActive) return 'translate(15.5px, 7.8px) scale(0.778)';
                    return 'translate(0px, 0px) scale(1)';
                };
                
                return (
                    <svg viewBox="0 0 140 140" className="w-full h-full max-h-[300px] drop-shadow-md overflow-visible">
                        <style>
                            {`
                                .draw-anim { stroke-dasharray: 150; stroke-dashoffset: 150; animation: draw 1.5s ease-in-out forwards; }
                                .fade-in { opacity: 0; animation: fadeIn 1s ease-in forwards; }
                                @keyframes draw { to { stroke-dashoffset: 0; } }
                                @keyframes fadeIn { to { opacity: 1; } }
                            `}
                        </style>
                        
                        <g style={{ transform: getCameraTransform(), transition: 'transform 0.8s ease-in-out' }}>
                            <g style={{ opacity: isHalfCircleActive ? 0 : 1, transition: 'opacity 0.5s ease-in-out' }}>
                                <g className="text-gray-400">
                                    <rect x="30" y="30" width="80" height="80" fill="none" stroke="#9ca3af" strokeWidth="1.5" strokeDasharray="4 4" />
                                    
                                    {(v === 'full' || v === 'arc1' || v === 'math1' || v === 'combine') && (
                                        <g className="fade-in">
                                            <line x1="25" y1="30" x2="25" y2="110" stroke="#4b5563" strokeWidth="1" />
                                            <path d="M 22 35 L 25 30 L 28 35" fill="none" stroke="#4b5563" strokeWidth="1" />
                                            <path d="M 22 105 L 25 110 L 28 105" fill="none" stroke="#4b5563" strokeWidth="1" />
                                            <text x="10" y="75" fill="#374151" fontSize="8" textAnchor="middle" transform="rotate(-90 10,75)">28 cm</text>
                                            
                                            <line x1="30" y1="115" x2="110" y2="115" stroke="#4b5563" strokeWidth="1" />
                                            <path d="M 35 112 L 30 115 L 35 118" fill="none" stroke="#4b5563" strokeWidth="1" />
                                            <path d="M 105 112 L 110 115 L 105 118" fill="none" stroke="#4b5563" strokeWidth="1" />
                                            <text x="70" y="128" fill="#374151" fontSize="8" textAnchor="middle">28 cm</text>
                                        </g>
                                    )}

                                    {(v === 'arc1' || v === 'math1' || v === 'combine' || v === 'celebrate' || v === 'full') && (
                                        <path d="M 30 35 L 35 35 L 35 30" fill="none" stroke="#9ca3af" strokeWidth="1" />
                                    )}
                                    {(v === 'arc2' || v === 'combine' || v === 'celebrate' || v === 'full') && (
                                        <path d="M 105 110 L 105 105 L 110 105" fill="none" stroke="#9ca3af" strokeWidth="1" />
                                    )}
                                </g>
                            </g>

                            {v === 'full' && (
                                <path d="M 30 110 A 80 80 0 0 1 110 30 A 80 80 0 0 1 30 110 Z" fill="#d9f99d" stroke="#4d7c0f" strokeWidth="1.5" className="fade-in" />
                            )}

                            {v === 'celebrate' && (
                                <g style={{ opacity: isHalfCircleActive ? 1 : 0, transition: 'opacity 0.8s ease-in-out 0.6s', pointerEvents: 'none' }}>
                                    <line x1="-10" y1="70" x2="150" y2="70" stroke="#6b7280" strokeWidth="2" strokeDasharray="6 6" />
                                    <text x="70" y="60" fill="#4b5563" fontSize="14" textAnchor="middle" fontWeight="bold">完整的半個圓 (1/2 圓)</text>
                                    <text x="110" y="110" fill="#f97316" fontSize="12" textAnchor="middle" fontWeight="bold">第一個 1/4</text>
                                    <text x="30" y="110" fill="#ea580c" fontSize="12" textAnchor="middle" fontWeight="bold">第二個 1/4</text>
                                    <path d="M -10 155 Q 70 170 150 155" fill="none" stroke="#22c55e" strokeWidth="2" strokeDasharray="4 4"/>
                                    <text x="70" y="175" fill="#15803d" fontSize="14" textAnchor="middle" fontWeight="bold">總周界 = 88 cm</text>
                                </g>
                            )}

                            {v === 'arc1' && isHintActive && (
                                <g className="fade-in">
                                    <circle cx="30" cy="30" r="80" fill="#fef08a" fillOpacity="0.2" stroke="#f97316" strokeWidth="1.5" strokeDasharray="6 6" />
                                    <path d="M -50 30 L 110 30" fill="none" stroke="#f97316" strokeWidth="1" strokeDasharray="3 3" opacity="0.6" />
                                    <path d="M 30 -50 L 30 110" fill="none" stroke="#f97316" strokeWidth="1" strokeDasharray="3 3" opacity="0.6" />
                                </g>
                            )}

                            {v === 'arc2' && isHintActive && (
                                <g className="fade-in">
                                    <circle cx="110" cy="110" r="80" fill="#fef08a" fillOpacity="0.2" stroke="#ea580c" strokeWidth="1.5" strokeDasharray="6 6" />
                                    <path d="M 30 110 L 190 110" fill="none" stroke="#ea580c" strokeWidth="1" strokeDasharray="3 3" opacity="0.6" />
                                    <path d="M 110 30 L 110 190" fill="none" stroke="#ea580c" strokeWidth="1" strokeDasharray="3 3" opacity="0.6" />
                                </g>
                            )}

                            {(v === 'arc1' || v === 'math1' || v === 'combine' || v === 'celebrate') && (
                                <g style={{ transform: isHalfCircleActive ? 'translate(40px, 40px)' : 'translate(0px, 0px)', transition: 'transform 1.2s ease-in-out' }}>
                                    <circle cx="30" cy="30" r="2" fill="black" className="fade-in" />
                                    <path d="M 110 30 A 80 80 0 0 1 30 110" fill="none" stroke="#f97316" strokeWidth="2.5" pathLength="150" className={v === 'arc1' ? 'draw-anim' : ''} />
                                </g>
                            )}

                            {(v === 'arc2' || v === 'combine' || v === 'celebrate') && (
                                <g style={{ transform: isHalfCircleActive ? 'translate(70px, 70px) rotate(-90deg) translate(-110px, -110px)' : 'translate(110px, 110px) rotate(0deg) translate(-110px, -110px)', transition: 'transform 1.2s ease-in-out' }}>
                                    <circle cx="110" cy="110" r="2" fill="black" className="fade-in" />
                                    <path d="M 30 110 A 80 80 0 0 1 110 30" fill="none" stroke="#ea580c" strokeWidth="2.5" pathLength="150" className={v === 'arc2' || v === 'combine' ? 'draw-anim' : ''} />
                                </g>
                            )}

                            {v === 'celebrate' && (
                                <g style={{ opacity: isHalfCircleActive ? 0 : 1, transition: 'opacity 0.5s ease-in-out' }}>
                                    <path d="M 30 110 A 80 80 0 0 1 110 30 A 80 80 0 0 1 30 110 Z" fill="#d9f99d" className="fade-in" />
                                </g>
                            )}
                        </g>
                    </svg>
                );
            };

            return (
                <div className="flex items-center justify-center min-h-screen p-4 font-sans text-gray-800">
                    <div className="bg-white rounded-2xl shadow-xl w-full max-w-3xl overflow-hidden flex flex-col">
                        <div className="bg-blue-600 text-white p-4">
                            <h1 className="text-2xl font-bold flex items-center gap-2">
                                <Lightbulb className="text-yellow-300" />
                                互動數學魔法：葉子的周界
                            </h1>
                            <div className="flex gap-1 mt-4">
                                {steps.map((_, index) => (
                                    <div key={index} className={`h-2 flex-1 rounded-full transition-all duration-300 ${index <= currentStep ? 'bg-yellow-400' : 'bg-blue-800'}`} />
                                ))}
                            </div>
                        </div>

                        <div className="flex-1 p-6 md:p-8 flex flex-col md:flex-row gap-8 items-center" style={{ backgroundImage: "url('https://www.transparenttextures.com/patterns/notebook-dark.png')" }}>
                            <div className="w-full md:w-1/2 flex items-center justify-center bg-white border-2 border-dashed border-blue-200 rounded-xl p-4 min-h-[250px] relative">
                                {renderVisual()}
                                {steps[currentStep].visual === 'celebrate' && !showHalfCircleHint && (
                                    <div className="absolute top-4 right-4 animate-bounce text-yellow-500">
                                        <CheckCircle2 size={48} />
                                    </div>
                                )}
                            </div>

                            <div className="w-full md:w-1/2 flex flex-col gap-4 min-h-[200px] justify-center bg-white/80 p-4 rounded-xl shadow-sm backdrop-blur-sm">
                                <h2 className="text-2xl font-bold text-blue-800 transition-opacity duration-300">{steps[currentStep].title}</h2>
                                <p className="text-lg text-gray-700 leading-relaxed">{steps[currentStep].content}</p>
                                <div className="mt-2 text-md font-medium">{steps[currentStep].detail}</div>

                                {(steps[currentStep].visual === 'arc1' || steps[currentStep].visual === 'arc2') && (
                                    <button onClick={() => setShowFullCircleHint(!showFullCircleHint)} className={`mt-4 flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold transition-all w-fit shadow-md border-2 ${showFullCircleHint ? 'bg-yellow-50 text-yellow-700 border-yellow-300 hover:bg-yellow-100' : 'bg-yellow-400 text-yellow-900 border-yellow-500 hover:bg-yellow-500 hover:-translate-y-1'}`}>
                                        <Lightbulb size={22} className={showFullCircleHint ? 'text-yellow-500' : 'text-yellow-100'} />
                                        {showFullCircleHint ? '💡 隱藏提示，回到原圖' : '💡 點我！看完整的圓形'}
                                    </button>
                                )}

                                {steps[currentStep].visual === 'celebrate' && (
                                    <button onClick={() => setShowHalfCircleHint(!showHalfCircleHint)} className={`mt-4 flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold transition-all w-fit shadow-md border-2 ${showHalfCircleHint ? 'bg-purple-50 text-purple-700 border-purple-300 hover:bg-purple-100' : 'bg-purple-500 text-white border-purple-600 hover:bg-purple-600 hover:-translate-y-1'}`}>
                                        <Lightbulb size={22} className={showHalfCircleHint ? 'text-purple-500' : 'text-purple-100'} />
                                        {showHalfCircleHint ? '💡 變回原本的葉子' : '💡 點我！看「半個圓」的魔法'}
                                    </button>
                                )}
                            </div>
                        </div>

                        <div className="bg-gray-50 border-t border-gray-200 p-4 flex items-center justify-between">
                            <button onClick={togglePlay} className="flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-full transition-colors">
                                {isPlaying ? <Pause size={20} /> : (currentStep === totalSteps - 1 ? <RotateCcw size={20} /> : <Play size={20} />)}
                                {isPlaying ? '暫停動畫' : (currentStep === totalSteps - 1 ? '重新播放' : '自動播放')}
                            </button>

                            <div className="flex items-center gap-3">
                                <button onClick={handlePrev} disabled={currentStep === 0} className={`p-3 rounded-full flex items-center justify-center transition-colors ${currentStep === 0 ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-white border-2 border-blue-600 text-blue-600 hover:bg-blue-50'}`} title="上一步"><ChevronLeft size={24} /></button>
                                <span className="font-bold text-gray-500 w-16 text-center">{currentStep + 1} / {totalSteps}</span>
                                <button onClick={handleNext} disabled={currentStep === totalSteps - 1} className={`p-3 rounded-full flex items-center justify-center transition-colors ${currentStep === totalSteps - 1 ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-blue-600 text-white hover:bg-blue-700 shadow-md'}`} title="下一步"><ChevronRight size={24} /></button>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
